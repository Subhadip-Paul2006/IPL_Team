# ==============================================================================
# RR Squad Intelligence Platform - Environment Configuration Template
# ------------------------------------------------------------------------------
# MANDATORY SECURITY CONSTRAINTS:
# 1. NEVER commit real credentials, service-role keys, or database URLs to Git.
# 2. Copy this template to '.env' for local development. '.env' is .gitignored.
# 3. SUPABASE_SECRET_KEY bypasses Row Level Security (RLS) and MUST NEVER be
#    exposed to client browsers, public APIs, or client-side frontends.
# ==============================================================================

# Supabase Project API Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_dummy_key_do_not_use_real
SUPABASE_SECRET_KEY=sb_secret_dummy_service_role_key_do_not_use_real

# PostgreSQL 16 Connection URL (Supabase Transaction Pooler / Direct)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Application Runtime Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
